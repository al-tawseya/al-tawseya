# انسخي هذا الملف إلى .env وعبّي القيم — لا تلتزمي .env في Git أبدًا

# مفتاح Gemini (اختياري — بدونه يعمل المستخرج المحلي الحتمي)
GOOGLE_API_KEY=

# نموذج Gemini المستخدم للاستخراج
GEMINI_MODEL=gemini-2.0-flash

# مسار قاعدة البيانات (افتراضي: decision_engine.db بجانب app.py)
DATABASE_FILE=decision_engine.db

# الشبكة
HOST=0.0.0.0
PORT=8000

# مستوى السجلات
LOG_LEVEL=INFO

# محرك البحث المباشر
LIVE_SEARCH_ENABLED=true
LIVE_SEARCH_MAX=8
SEARCH_QUERY_COUNT=8
SEARCH_CACHE_TTL=180
# قالب تحويل العملات؛ إذا فشل التحويل لا يتم اختراع سعر JOD
FX_API_URL_TEMPLATE=https://open.er-api.com/v6/latest/{currency}
